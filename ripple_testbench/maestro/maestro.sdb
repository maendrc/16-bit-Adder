<?xml version="1.0"?>
<setupdb version="7">maestro
	<active>Active Setup
		<jobcontrolmode>LSCS</jobcontrolmode>
		<corners>
			<corner enabled="1">_default</corner>
		</corners>
		<sharedvarinfo></sharedvarinfo>
		<overwritehistory>0</overwritehistory>
		<tests>
			<test>project2_tb_adder_1
				<tool>ADE</tool>
				<tooloptions>
					<option>cell
						<value>tb_adder_ripple2</value>
					</option>
					<option>lib
						<value>project2</value>
					</option>
					<option>path
						<value>$AXL_SETUPDB_DIR</value>
					</option>
					<option>sim
						<value>spectre</value>
					</option>
					<option>view
						<value>schematic</value>
					</option>
					<option>state
						<value>active</value>
					</option>
				</tooloptions>
				<origoptions></origoptions>
				<outputs>
					<output>(max(cross(VT("/S15") 0.6 1 "rising") cross(VT("/Cout") 0.6 1 "rising")) - cross(VT("/A0") 0.6 1 "rising"))
						<evalType>point</evalType>
					</output>
					<output>(max(cross(clip(VT("/S15") 0 5e-10) 0.6 1 "rising" nil nil nil) cross(clip(VT("/Cout") 0 5e-10) 0.6 1 "rising" nil nil nil)) - cross(clip(VT("/A0") 0 5e-10) 0.6 1 "rising" nil nil nil))
						<evalType>point</evalType>
					</output>
					<output>S15
						<evalType>point</evalType>
					</output>
					<output>C16
						<evalType>point</evalType>
					</output>
					<output>A15
						<evalType>point</evalType>
					</output>
					<output>toutB
						<evalType>point</evalType>
					</output>
					<output>toutC
						<evalType>point</evalType>
					</output>
					<output>(integ((abs(VT("/VDD")) * abs(IT("/V0/PLUS"))) 0 4e-09 " ") / 4e-09)
						<evalType>point</evalType>
					</output>
					<output>power
						<evalType>point</evalType>
					</output>
					<output>PDP_A
						<evalType>point</evalType>
					</output>
					<output>toutA
						<evalType>point</evalType>
					</output>
					<output>"/S12"
						<evalType>point</evalType>
					</output>
					<output>PDP_B
						<evalType>point</evalType>
					</output>
					<output>PDP_C
						<evalType>point</evalType>
					</output>
					<output>S14
						<evalType>point</evalType>
					</output>
					<output>(max(cross(clip(VT("/S15") 0 9e-10) 0.6 1 "falling" nil nil nil) cross(clip(VT("/C16") 0 9e-10) 0.6 1 "rising" nil nil nil)) - cross(clip(VT("/A15") 0 9e-10) 0.6 1 "rising" nil nil nil))
						<evalType>point</evalType>
					</output>
					<output>(max(cross(clip(VT("/S14") 0 9e-10) 0.6 1 "falling" nil nil nil) cross(clip(VT("/C16") 0 9e-10) 0.6 1 "rising" nil nil nil)) - cross(clip(VT("/A15") 0 9e-10) 0.6 1 "rising" nil nil nil))
						<evalType>point</evalType>
					</output>
				</outputs>
				<vars></vars>
			</test>
		</tests>
		<extensions>
